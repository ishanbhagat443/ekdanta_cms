APP_NAME="Ekdanta CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production: LOG_CHANNEL=daily (14-day rotation). Security events always
# land in storage/logs/security-*.log (90-day rotation).
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Backups: explicit dump binary if not in PATH (auto-detected on WAMP).
# MYSQLDUMP_PATH="C:/wamp64/bin/mysql/mysql8.2.0/bin/mysqldump.exe"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ekdanta_cms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Where user uploads are stored/served (single source — see config/gsm.php +
# app/Helpers/helpers.php). Leave unset to use the app's own public/uploads
# (no `storage:link` symlink needed). To store OUTSIDE the app, set the
# ABSOLUTE filesystem path + the matching public URL:
#   CMS_UPLOAD_PATH=/home/USERNAME/public_html/uploads
#   CMS_UPLOAD_URL="${APP_URL}/uploads"
# Production: database (run `php artisan queue:work` via Supervisor / Task Scheduler).
# Form-notification mail is queued and will NOT send under sync=none scenarios.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@globalsilkmills.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Optional AI writing assistant. Leave AI_API_KEY empty and the feature does
# not appear anywhere in the admin and no request is ever made.
# AI_API_KEY=
# AI_PROVIDER=anthropic
# AI_API_URL=https://api.anthropic.com/v1/messages
# AI_API_FORMAT=anthropic       # anthropic | openai
# AI_MODEL=claude-sonnet-4-5
# AI_RATE_LIMIT=20              # requests per minute, per user
