            "caret-end": { "part": "ah-blink", "trigger": "loop", "preset": "ek-ty-blink", "duration": 1000, "ease": "steps(1)" },
            "swoosh": { "part": "ah-swoosh", "trigger": "load", "keyframes": { "strokeDashoffset": [1, 0] }, "duration": 700, "delay": 2350, "ease": "cubicBezier(0.6,0,0.2,1)" },
            "lede": { "part": "ah-lede", "trigger": "load", "preset": "ek-fade", "delay": 900 },
