            "brochure": { "part": "ah-bro", "trigger": "load", "preset": "ek-p-bro" },
            "phone": { "part": "ah-ph", "trigger": "load", "preset": "ek-p-ph" },
            "arrow": { "part": "ah-arrow", "trigger": "load", "keyframes": { "strokeDashoffset": [1, 0] }, "duration": 700, "delay": 1900, "ease": "cubicBezier(0.6,0,0.2,1)" },
            "tells": { "part": "ah-tells", "trigger": "load", "preset": "ek-p-stk", "delay": 1750 },
            "shows": { "part": "ah-shows", "trigger": "load", "preset": "ek-p-stk", "delay": 2200 },
            "arrow-head": { "part": "ah-head-stk", "trigger": "load", "preset": "ek-p-stk", "delay": 2450 },
            "messages": { "part": "ah-bub", "trigger": "loop", "preset": "ek-p-bub", "delay": 2500, "stagger": 1200 },
            "story-1": { "part": "ah-seg0", "trigger": "loop", "preset": "ek-p-seg0" },
            "story-2": { "part": "ah-seg1", "trigger": "loop", "preset": "ek-p-seg1" },
            "story-3": { "part": "ah-seg2", "trigger": "loop", "preset": "ek-p-seg2" },
            "gear": { "part": "ah-spin", "trigger": "loop", "preset": "ek-p-spin" },
            "gear-small": { "part": "ah-spin-r", "trigger": "loop", "preset": "ek-p-spin", "duration": 4000, "direction": "reverse" },
            "belt": { "part": "ah-belt", "trigger": "loop", "preset": "ek-p-belt" },
            "boxes": { "part": "ah-box", "trigger": "loop", "preset": "ek-p-box", "delay": -3000, "stagger": 1500 },
            "check": { "part": "ah-qc", "trigger": "loop", "preset": "ek-p-qc" },
            "scan": { "part": "ah-scan", "trigger": "loop", "preset": "ek-p-scan" },
            "heart": { "part": "ah-heart", "trigger": "loop", "preset": "ek-p-heart" },
            "text-out": { "part": "ah-head", "trigger": "scrub", "ease": "linear", "reduce": "start", "keyframes": { "opacity": [1, 0] }, "range": [220, 600] },
            "text-drift": { "part": "ah-head", "trigger": "scrub", "ease": "linear", "reduce": "start", "keyframes": { "translateY": [0, 120] }, "range": [0, 1000] },
            "dots": { "part": "ah-dots", "trigger": "scrub", "ease": "linear", "reduce": "start", "keyframes": { "translateY": [0, 60] }, "range": [0, 1000] },
            "brochure-rise": { "part": "ah-bro-y", "trigger": "scrub", "ease": "linear", "reduce": "start", "keyframes": { "translateY": [0, -100] }, "range": [0, 1000] },
            "phone-rise": { "part": "ah-ph-y", "trigger": "scrub", "ease": "linear", "reduce": "start", "keyframes": { "translateY": [0, -200] }, "range": [0, 1000] },
