{
    "desktop": {
        "stage": {
            "pin": true,
            "length": 400
        },
        "tracks": {
            "eyebrow": {
                "part": "lh-eyebrow",
                "trigger": "load",
                "preset": "ek-fade"
            },
            "heading": {
                "part": "lh-line",
                "trigger": "load",
                "preset": "ek-rise",
                "delay": 120,
                "stagger": 140
            },
            "text": {
                "part": "lh-text",
                "trigger": "load",
                "preset": "ek-fade",
                "delay": 500
            },
            "date": {
                "part": "lh-meta",
                "trigger": "load",
                "preset": "ek-fade",
                "delay": 650
            },
            "buttons": {
                "part": "lh-actions",
                "trigger": "load",
                "preset": "ek-fade",
                "delay": 800
            },
            "rings": {
                "part": "lg-ring",
                "trigger": "loop",
                "preset": "ek-lg-ring",
                "stagger": 1600
            },
            "card": {
                "part": "lg-pop",
                "trigger": "load",
                "preset": "ek-lg-pop",
                "delay": 150
            },
            "shield": {
                "part": "lg-draw",
                "trigger": "load",
                "keyframes": {
                    "strokeDashoffset": [
                        1,
                        0
                    ]
                },
                "duration": 1200,
                "delay": 500,
                "ease": "cubicBezier(0.6,0,0.2,1)"
            },
            "shield-fill": {
                "part": "lg-fill",
                "trigger": "load",
                "preset": "ek-lg-fade",
                "delay": 1400
            },
            "lock": {
                "part": "lg-shackle",
                "trigger": "load",
                "preset": "ek-lg-shut",
                "delay": 1600
            },
            "dots": {
                "part": "lg-dots",
                "trigger": "load",
                "preset": "ek-lg-fade",
                "duration": 500,
                "delay": 1900
            },
            "privacy-chips": {
                "part": "lg-chip",
                "trigger": "load",
                "preset": "ek-lg-chip",
                "delay": 1900,
                "stagger": 220
            },
            "agreement-lines": {
                "part": "lg-line",
                "trigger": "load",
                "preset": "ek-lg-line",
                "delay": 500,
                "stagger": 170
            },
            "signatures": {
                "part": "lg-sign",
                "trigger": "load",
                "keyframes": {
                    "strokeDashoffset": [
                        1,
                        0
                    ]
                },
                "duration": 900,
                "delay": 1700,
                "stagger": 600,
                "ease": "inOutQuad"
            },
            "stamp": {
                "part": "lg-stamp",
                "trigger": "load",
                "preset": "ek-lg-stamp",
                "delay": 3000
            },
            "terms-chips": {
                "part": "lg-tchip",
                "trigger": "load",
                "preset": "ek-lg-chip",
                "delay": 2700,
                "stagger": 220
            },
            "text-fade": {
                "part": "lh-head",
                "trigger": "scrub",
                "keyframes": {
                    "opacity": [
                        1,
                        0
                    ]
                },
                "range": [
                    160,
                    580
                ],
                "ease": "linear",
                "reduce": "start"
            },
            "text-lift": {
                "part": "lh-head",
                "trigger": "scrub",
                "keyframes": {
                    "translateY": [
                        0,
                        -80
                    ]
                },
                "range": [
                    0,
                    600
                ],
                "ease": "linear",
                "reduce": "start"
            },
            "picture-drift": {
                "part": "lh-drift",
                "trigger": "scrub",
                "keyframes": {
                    "translateY": [
                        0,
                        -70
                    ]
                },
                "range": [
                    0,
                    600
                ],
                "ease": "linear",
                "reduce": "start"
            },
            "card-tilt": {
                "part": "lg-card",
                "trigger": "scrub",
                "keyframes": {
                    "rotate": [
                        -4,
                        -11
                    ],
                    "translateY": [
                        0,
                        -30
                    ]
                },
                "range": [
                    0,
                    600
                ],
                "ease": "linear",
                "reduce": "start"
            },
            "shield-move": {
                "part": "lg-shield",
                "trigger": "scrub",
                "keyframes": {
                    "translateY": [
                        0,
                        -40
                    ],
                    "scale": [
                        1,
                        0.92
                    ]
                },
                "range": [
                    0,
                    600
                ],
                "ease": "linear",
                "reduce": "start"
            },
            "stamp-turn": {
                "part": "lg-stamp-turn",
