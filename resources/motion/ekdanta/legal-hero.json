                "keyframes": {
                    "rotate": [
                        0,
                        24
                    ]
                },
                "range": [
                    0,
                    600
                ],
                "ease": "linear",
                "reduce": "start"
            },
            "chip-1": {
                "part": "lg-chip-a",
                "trigger": "scrub",
                "keyframes": {
                    "translateX": [
                        0,
                        -90
                    ],
                    "translateY": [
                        0,
                        -40
                    ]
                },
                "range": [
                    0,
                    600
                ],
                "ease": "linear",
                "reduce": "start"
            },
            "chip-2": {
                "part": "lg-chip-b",
                "trigger": "scrub",
                "keyframes": {
                    "translateX": [
                        0,
                        80
                    ],
                    "translateY": [
                        0,
                        -20
                    ]
