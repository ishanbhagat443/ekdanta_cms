# ─────────────────────────────────────────────────────────────────────────
# Ekdanta CMS — PRODUCTION .env template
#
# Copy to `.env` ON THE LIVE SERVER ONLY (never over your local WAMP .env)
# and fill in every ***FILL IN*** value. Then:
#
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan db:seed --force
#   php artisan mm:install-logos
#   php artisan mm:import-catalog-media
#   npm ci && npm run build
#   php artisan config:cache route:cache view:cache
#
# See DEPLOYMENT.md for the full checklist.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME="Ekdanta CMS"
APP_ENV=production
# Generated on the server by `php artisan key:generate` — never reuse the local key.
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` on a live site fills the disk and logs request payloads.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=***FILL IN***
DB_USERNAME=***FILL IN***
DB_PASSWORD=***FILL IN***

# Where user uploads are stored/served. Leave BOTH unset to use the app's own
# public/uploads (no symlink needed). Set them only when uploads must live
# outside the app — the web server must serve CMS_UPLOAD_PATH at CMS_UPLOAD_URL.
#CMS_UPLOAD_PATH=/home/USERNAME/public_html/uploads
#CMS_UPLOAD_URL="${APP_URL}/uploads"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# HTTPS only — stops the session cookie being sent over plain HTTP.
SESSION_SECURE_COOKIE=true

# Real SMTP is REQUIRED: contact-form notifications and password resets
# silently fail without it. Fill in your own SMTP host below.
#
# Port 465 = implicit TLS -> MAIL_ENCRYPTION=ssl  (using "tls" on 465 fails).
# Port 587 = STARTTLS     -> MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS must be the SAME mailbox as MAIL_USERNAME, or Hostinger
# rejects the message as a spoofed sender (Hostinger and most hosts do).
#
# Quote the password if it contains @ or # — an unquoted # starts a comment
# and everything after it is silently discarded.
MAIL_MAILER=smtp
MAIL_HOST=***FILL IN***
MAIL_PORT=465
MAIL_USERNAME=***FILL IN***
MAIL_PASSWORD="***FILL IN — do not commit the real password***"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="***FILL IN***"
MAIL_FROM_NAME="${APP_NAME}"

# Optional — Meta WhatsApp Cloud API, for sending orders automatically instead
# automatically. Configure under CMS → Settings → WhatsApp instead if
# you prefer to keep the credentials in the database.
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_ACCESS_TOKEN=

# Optional AI writing assistant. Leave AI_API_KEY empty and the feature does
# not appear anywhere in the admin and no request is ever made.
# AI_API_KEY=
# AI_PROVIDER=anthropic
# AI_API_URL=https://api.anthropic.com/v1/messages
# AI_API_FORMAT=anthropic       # anthropic | openai
# AI_MODEL=claude-sonnet-4-5
# AI_RATE_LIMIT=20              # requests per minute, per user
